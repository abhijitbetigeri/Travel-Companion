# Cognee — hosted tenant (cognify inference billed to your Cognee credit)
COGNEE_BASE_URL="https://tenant-XXXXXXXX.aws.cognee.ai"
COGNEE_API_KEY=""

# Bright Data — hosted remote MCP server, no install
BRIGHTDATA_API_TOKEN=""

# AWS Bedrock — the Strands agent's reasoning model
AWS_REGION="us-west-2"
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"

# Dataset names — the two memory lifecycles
COGNEE_DATASET_SELF="self"
COGNEE_DATASET_WORLD="world"

# World memory is only trusted this long before the agent re-fetches it live
WORLD_FRESHNESS_HOURS="24"
